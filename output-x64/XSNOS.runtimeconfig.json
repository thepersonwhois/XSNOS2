      "Cosmos.Kernel.System.Network.Enabled": true,
      "Cosmos.Kernel.System.Storage.Enabled": true,
      "Cosmos.Kernel.System.Filesystems.Fat.Enabled": true,
      "Cosmos.Kernel.HAL.Usb.Enabled": true,
      "Cosmos.Kernel.System.Graphics.Enabled": true,
      "Cosmos.Kernel.Core.Scheduler.Enabled": true,
      "Cosmos.Kernel.System.Audio.Enabled": true,
      "Microsoft.Extensions.DependencyInjection.VerifyOpenGenericServiceTrimmability": true,
      "System.ComponentModel.DefaultValueAttribute.IsSupported": false,
